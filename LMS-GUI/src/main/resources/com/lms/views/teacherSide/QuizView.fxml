<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.lms.controllers.teacherSide.QuizViewController">
    <children>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true" prefHeight="1033.0" prefWidth="1176.0" style="-fx-background-color: transparent;" vbarPolicy="ALWAYS">
            <content>
                <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefHeight="2702.0" prefWidth="1174.0" style="-fx-background-color: #f4f6fa;">
                    <children>
                        <VBox prefHeight="45.0" prefWidth="1144.0">
                            <padding>
                                <Insets bottom="5.0" right="5.0" top="5.0" />
                            </padding>
                            <children>
                                <ImageView fx:id="backButton" fitHeight="40.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" rotate="180.0">
                                    <image>
                                        <Image url="@../../images/back-icon.png" />
                                    </image>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                </ImageView>
                            </children>
                        </VBox>
                        <AnchorPane>
                            <children>
                                <VBox spacing="10.0" AnchorPane.leftAnchor="0.0">
                                    <children>
                                        <Text fx:id="quizId" strokeType="OUTSIDE" strokeWidth="0.0" text="A000001">
                                            <font>
                                                <Font name="AppleGothic Regular" size="18.0" />
                                            </font>
                                        </Text>
                                        <Text fx:id="quizTitle" strokeType="OUTSIDE" strokeWidth="0.0" text="Quiz Title">
                                            <font>
                                                <Font name="AppleGothic Regular" size="18.0" />
                                            </font>
                                        </Text>
                                    </children>
                                </VBox>
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </AnchorPane>
                        <VBox minHeight="267.0" prefHeight="267.0" prefWidth="1144.0">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Description">
                                    <font>
                                        <Font name="AppleGothic Regular" size="18.0" />
                                    </font>
                                </Text>
                                <TextArea fx:id="quizDescription" disable="true" prefHeight="239.0" prefWidth="900.0" style="-fx-background-color: #f4f6fa; -fx-border-color: #f4f6fa; -fx-background-radius: 0; -fx-border-width: 0;" wrapText="true" />
                            </children>
                            <VBox.margin>
                                <Insets top="40.0" />
                            </VBox.margin>
                        </VBox>
                        <VBox prefHeight="128.0" prefWidth="1144.0">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </VBox>
                        <HBox prefHeight="19.0" prefWidth="1144.0" spacing="20.0">
                            <children>
                                <Button fx:id="editButton" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: black; -fx-border-radius: 30; -fx-background-radius: 30;" text="Edit" />
                                <Button fx:id="deleteButton" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: black; -fx-border-radius: 30; -fx-background-radius: 30;" text="Delete" />
                            </children>
